#!/usr/bin/env ruby
# frozen_string_literal: true

# ember — an AUR helper and pacman wrapper 

#   ember                    update system + AUR packages
#   ember install <pkg...>   install from the repos or the AUR
#   ember local   <file...>  install local package files (*.pkg.tar.*)
#   ember remove  <pkg...>   remove packages and unused dependencies
#   ember search  <pkg...>   search repos and the AUR
#   ember clean              empty the caches
#   ember list               lists installed packages

# emb works as a shorthand (symlink it to ember)
# Only the Ruby standard library is used

require 'json'
require 'net/http'
require 'uri'
require 'fileutils'
require 'open3'
require 'io/console'
require 'set'
require 'shellwords'

module Ember
  VERSION   = '2.8-1'
  CACHE     = File.join(ENV['XDG_CACHE_HOME'] || File.join(Dir.home, '.cache'), 'ember')
  PKG_DIR   = File.join(CACHE, 'pkg')    # built AUR packages
  BUILD_DIR = File.join(CACHE, 'build')  # AUR git clones + downloaded sources
  LOG_DIR   = File.join(CACHE, 'logs')    # makepkg / pacman logs
  PACMAN_CACHE = '/var/cache/pacman/pkg'

  class Error < StandardError; end

  class << self
    attr_accessor :verbose
  end

  # UI 
  module UI
    module_function

    GREEN = '38;5;114'
    CYAN  = '38;5;80'
    RED   = '38;5;203'
    AMBER = '38;5;221'
    EMBER = '38;5;141' # purple

    Row = Struct.new(:name, :ver, :size)

    def color? = $stdout.tty? && !ENV.key?('NO_COLOR')
    def paint(code, s) = color? ? "\e[#{code}m#{s}\e[0m" : s.to_s
    def bold(s)  = paint('1', s)
    def dim(s)   = paint('2', s)
    def ember(s) = paint("1;#{EMBER}", s)
    def green(s) = paint(GREEN, s)
    def cyan(s)  = paint(CYAN, s)
    def red(s)   = paint(RED, s)
    def amber(s) = paint(AMBER, s)

    def width
      cols = (IO.console.winsize.last rescue 80)
      cols.clamp(60, 100)
    end

    def rule = dim('━' * width)
    def trunc(s, n) = s.to_s.size > n ? "#{s.to_s[0, n - 1]}…" : s.to_s
    def plural(n) = n == 1 ? 'Package' : 'Packages'

    def step(msg) = puts("\n#{ember('▸')} #{bold(msg)}")
    def note(msg) = puts("#{cyan('ℹ')} #{msg}")
    def ok(msg)   = puts("#{green('✔')} #{msg}")
    def warn(msg) = $stderr.puts("#{amber('!')} #{msg}")
    def err(msg)  = $stderr.puts("#{red('error:')} #{msg}")

    def human(bytes)
      b = bytes.to_f
      return '0 B' if b <= 0

      units = %w[B KB MB GB TB]
      i = 0
      while b >= 1024 && i < units.size - 1
        b /= 1024
        i += 1
      end
      i.zero? ? "#{b.to_i} B" : format('%.1f %s', b, units[i])
    end

    # Highlight matches (used by search)
    def hl(text, re, base: '')
      return text unless color? && re

      body = text.gsub(re) { |m| "\e[1;#{EMBER}m#{m}\e[0m#{base}" }
      "#{base}#{body}\e[0m"
    end

    def spin(msg)
      return yield unless $stdout.tty?

      frames = %w[⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏]
      done = false
      th = Thread.new do
        i = 0
        until done
          print "\r#{ember(frames[i % frames.size])} #{msg}…"
          $stdout.flush
          i += 1
          sleep 0.08
        end
      end
      begin
        yield
      ensure
        done = true
        th.join
        print "\r\e[K"
      end
    end

    def confirm(question = 'Do you want to continue?', default: true, assume: false)
      render = lambda do |sel|
        hint = sel ? "#{ember('Y')}#{dim('/n')}" : "#{dim('y/')}#{ember('N')}"
        "#{bold(question)} #{dim('[')}#{hint}#{dim(']')} "
      end

      if assume
        puts "#{render.call(true)}#{dim('y')}"
        return true
      end

      unless $stdin.tty? && $stdout.tty?
        print render.call(default)
        $stdout.flush
        ans = $stdin.gets
        return false if ans.nil?

        ans = ans.strip.downcase
        return ans.empty? ? default : %w[y yes].include?(ans)
      end

      sel = default
      print render.call(sel)
      $stdout.flush
      $stdin.raw do
        loop do
          key = $stdin.getch
          case key
          when 'y', 'Y' then sel = true
          when 'n', 'N' then sel = false
          when "\t", ' ' then sel = !sel
          when "\e"
            seq = ($stdin.read_nonblock(2) rescue '')
            sel = true  if seq == '[D' # ←
            sel = false if seq == '[C' # →
          when "\r", "\n" then break
          when "\u0003" then raise Interrupt
          end
          print "\r\e[K#{render.call(sel)}"
          $stdout.flush
        end
      end
      puts
      sel
    end

    # sections: [{title:, color:, rows: [Row]}]
    def table(sections)
      rows = sections.flat_map { |s| s[:rows] }
      vw = [[rows.map { |r| r.ver.to_s.size }.max || 0, 8].max, 40].min
      sw = [[rows.map { |r| r.size.to_s.size }.max || 0, 5].max, 12].min
      pw = [width - vw - sw - 3, 20].max

      puts rule
      puts " #{ember('Package:'.ljust(pw))} #{ember('Version:'.ljust(vw))} #{ember('Size:'.rjust(sw))}"
      puts rule
      sections.each do |s|
        puts paint("1;#{s[:color]}", s[:title])
        s[:rows].each do |r|
          puts " #{bold(trunc(r.name, pw).ljust(pw))} #{paint(s[:color], trunc(r.ver, vw).ljust(vw))} #{dim(r.size.to_s.rjust(sw))}"
        end
      end
    end

    # lines: [[verb, count, note]], stats: [[label, value]]
    def summary(lines, stats)
      puts rule
      puts " #{bold('Summary')}"
      puts rule
      lines.each do |verb, n, note|
        puts " #{bold(verb.ljust(10))} #{n} #{plural(n)}#{note ? "  #{dim(note)}" : ''}"
      end
      puts
      stats.each { |k, v| puts " #{k.ljust(24)} #{bold(v)}" }
      puts
    end
  end

  # shell helpers 
  module Sh
    module_function

    ENV_C = { 'LC_ALL' => 'C' }.freeze # stable output for parsing

    def capture(*cmd)
      out, err, st = Open3.capture3(ENV_C, *cmd, stdin_data: '')
      [out, st.success?, err]
    rescue Errno::ENOENT
      raise Error, "#{cmd.first}: command not found"
    end

    def ok?(*cmd) = capture(*cmd)[1]
    def out(*cmd) = capture(*cmd)[0]
    def run(*cmd) = system(*cmd) ? true : false

    def su = @su ||= %w[syca sudo doas].find { |b| which(b) } || raise(Error, 'sudo, doas or syca is required')
    def su_n(*cmd) = su == 'syca' ? [su, *cmd] : [su, '-n', *cmd]

    def su_auth(quiet: false)
      cmd = su == 'sudo' ? [su, '-v'] : [su, 'true']
      quiet ? su_n(*cmd.drop(1)) : cmd
    end

    def which(bin)
      ENV['PATH'].to_s.split(':').any? { |d| File.executable?(File.join(d, bin)) }
    end

    def clean_errors(text)
      text.lines.map { |l| l.sub(/\A(error|warning):\s*/, '').strip }.reject(&:empty?).join("\n")
    end
  end

  # pacman helpers 
  module Pac
    module_function

    # Parse 'pacman -Si/-Qi' output into { name => { 'Field' => 'value' } }
    def info(flag, names)
      return {} if names.empty?

      out, = Sh.capture('pacman', flag, *names)
      out.split(/\n{2,}/).each_with_object({}) do |blk, acc|
        h = {}
        key = nil
        blk.each_line do |line|
          line = line.chomp
          if (m = line.match(/\A(\S[^:]*?)\s*:\s?(.*)\z/))
            key = m[1]
            h[key] = m[2].strip
          elsif key
            h[key] = "#{h[key]} #{line.strip}"
          end
        end
        acc[h['Name']] = h if h['Name']
      end
    end

    def bytes(str)
      m = str.to_s.match(/([\d.]+)\s*(B|KiB|MiB|GiB|TiB)/) or return 0
      m[1].to_f * (1024**%w[B KiB MiB GiB TiB].index(m[2]))
    end

    ASK_CONFLICTS = ['--ask', '4'].freeze

    def installed = Sh.out('pacman', '-Qq').split.to_set
    def installed?(name) = Sh.ok?('pacman', '-Qq', name)
    def satisfied?(dep) = Sh.ok?('pacman', '-T', dep)

    def repo?(name)
      @repo ||= {}
      @repo.fetch(name) { @repo[name] = Sh.ok?('pacman', '-Sp', '--noconfirm', *ASK_CONFLICTS, name) }
    end

    # 'foo>=1.0' -> 'foo'
    def dep_name(dep) = dep.to_s[/\A[^<>=]+/].to_s

    # Split a pacman Provides / Conflicts With field into its entries
    def split_deps(field)
      f = field.to_s.strip
      f.empty? || f == 'None' ? [] : f.split(/\s+/)
    end

    # Checks both directions: incoming conflicts with an installed package, and
    # an installed package that declares a conflict with something incoming.
    def conflicts(incoming)
      return {} if incoming.empty?

      hits = {}
      info('-Qi', installed.to_a).each do |name, h|
        next if incoming.key?(name) # being upgraded / replaced anyway

        have   = [name, *split_deps(h['Provides']).map { |d| dep_name(d) }]
        theirs = split_deps(h['Conflicts With'])
        incoming.each do |pkg, i|
          mine = [pkg, *i[:provides].map { |d| dep_name(d) }]
          forward = i[:conflicts].any? do |c|
            have.include?(dep_name(c)) && (c.match?(/[<>=]/) ? satisfied?(c) : true)
          end
          reverse = theirs.any? { |c| !c.match?(/[<>=]/) && mine.include?(c) }
          next unless forward || reverse

          hits[name] ||= { by: pkg, ver: h['Version'], size: bytes(h['Installed Size']) }
        end
      end
      hits
    end

    # Names of everything pacman would install for these targets (deps included)
    def plan(names)
      out, ok, err = Sh.capture('pacman', '-Sp', '--needed', '--noconfirm', *ASK_CONFLICTS, '--print-format', '%n', *names)
      raise Error, Sh.clean_errors(err) unless ok

      out.lines.map(&:strip).reject(&:empty?)
    end
  end

  # AUR
  module Aur
    module_function

    HOST = 'aur.archlinux.org'

    def rpc(path)
      uri = URI("https://#{HOST}/rpc/v5/#{path}")
      res = Net::HTTP.start(uri.host, uri.port, use_ssl: true, open_timeout: 10, read_timeout: 20) do |http|
        http.get(uri.request_uri, 'User-Agent' => "ember/#{VERSION}")
      end
      raise Error, "AUR returned HTTP #{res.code}" unless res.is_a?(Net::HTTPSuccess)

      json = JSON.parse(res.body)
      raise Error, "AUR: #{json['error']}" if json['type'] == 'error'

      json['results'] || []
    rescue SocketError, Timeout::Error, SystemCallError, OpenSSL::SSL::SSLError => e
      raise Error, "Could not reach the AUR (#{e.message})"
    end

    def info(names)
      @info ||= {}
      names = names.uniq
      names.reject { |n| @info.key?(n) }.each_slice(100) do |slice|
        q = slice.map { |n| "arg%5B%5D=#{URI.encode_www_form_component(n)}" }.join('&')
        found = rpc("info?#{q}")
        slice.each { |n| @info[n] = nil }
        found.each { |i| @info[i['Name']] = i }
      end
      names.filter_map { |n| @info[n] }
    end

    def search(term)
      rpc("search/#{URI.encode_www_form_component(term)}?by=name-desc")
    end

    # Find an AUR package 
    def provider(name)
      hit = rpc("search/#{URI.encode_www_form_component(name)}?by=provides").first
      hit && info([hit['Name']]).first
    rescue Error
      nil
    end
  end

  # dependency planner 
  class Planner
    Node = Struct.new(:name, :base, :version, :desc, :deps, :make, :explicit, :runtime,
                      :repo_deps, :repo_make, :aur_deps, :aur_make, :conflicts, :provides, keyword_init: true)

    attr_reader :aur, :repo_targets, :repo_runtime, :repo_build, :already, :missing

    def initialize(targets, aur_only: false)
      @targets = targets
      @aur_only = aur_only
      @aur = {}
      @queue = []
      @repo_targets = []
      @repo_runtime = []
      @repo_build = []
      @already = []
      @missing = []
    end

    def resolve
      unknown = []
      @targets.each do |t|
        if !@aur_only && Pac.installed?(t) then @already << t
        elsif !@aur_only && Pac.repo?(t)   then @repo_targets << t
        else unknown << t
        end
      end

      Aur.info(unknown).each { |i| add(i, explicit: true) }
      @missing = unknown.reject { |n| @aur.key?(n) }

      until @queue.empty?
        n = @queue.shift
        n.deps.each { |d| link(n, d, n.repo_deps, n.aur_deps) }
        n.make.each { |d| link(n, d, n.repo_make, n.aur_make) }
      end
      finalize
      self
    end

    # AUR build order (dependencies first)
    def ordered
      out = []
      seen = Set.new
      visit = lambda do |n|
        next unless seen.add?(n.name)

        (n.aur_deps + n.aur_make).each { |d| visit.call(@aur[d]) }
        out << n
      end
      @aur.values.select(&:explicit).each { |n| visit.call(n) }
      out
    end

    private

    def add(info, explicit: false)
      node = (@aur[info['Name']] ||= begin
        n = Node.new(name: info['Name'], base: info['PackageBase'], version: info['Version'],
                     desc: info['Description'].to_s, deps: info['Depends'] || [],
                     make: (info['MakeDepends'] || []) + (info['CheckDepends'] || []),
                     explicit: false, repo_deps: [], repo_make: [], aur_deps: [], aur_make: [],
                     conflicts: info['Conflicts'] || [], provides: info['Provides'] || [])
        @queue << n
        n
      end)
      node.explicit ||= explicit
      node
    end

    def link(owner, dep, repo_list, aur_list)
      name = dep[/\A[^<>=]+/]
      return if Pac.satisfied?(dep)
      return repo_list << name if Pac.repo?(name)

      info = Aur.info([name]).first || Aur.provider(name)
      raise Error, "Unable to resolve dependency '#{dep}' of #{owner.name}" unless info

      aur_list << add(info).name
    end

    # Work out which AUR packages are needed at runtime and which only to build
    def finalize
      runtime = Set.new
      stack = @aur.values.select(&:explicit)
      until stack.empty?
        n = stack.pop
        next unless runtime.add?(n.name)

        n.aur_deps.each { |d| stack << @aur[d] }
      end
      @aur.each_value { |n| n.runtime = runtime.include?(n.name) }

      nodes = @aur.values
      @repo_runtime = nodes.select(&:runtime).flat_map(&:repo_deps).uniq - @repo_targets
      @repo_build = (nodes.flat_map(&:repo_make) + nodes.reject(&:runtime).flat_map(&:repo_deps)).uniq -
                    @repo_runtime - @repo_targets
    end
  end

  # live progress panel 
  class Progress
    FRAMES = %w[⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏].freeze
    Item = Struct.new(:name, :ver, :state, :phase)

    def initialize(title)
      @title = title
      @items = []
      @tty = $stdout.tty? && !Ember.verbose
      @drawn = 0
      @tick = 0
      @paused = false
      @stopped = false
      @lock = Mutex.new
    end

    def add(name, ver)
      item = Item.new(name, ver, :pending, 'waiting')
      @items << item
      item
    end

    def set(item, state, phase)
      return if item.state == state && item.phase == phase

      item.state = state
      item.phase = phase
      puts "  #{item.name} #{item.ver}: #{phase}" unless @tty
    end

    def start
      return self unless @tty

      print "\e[?25l"
      @thread = Thread.new do
        loop do
          draw
          sleep 0.1
        end
      end
      self
    end

    def stop
      return if @stopped

      @stopped = true
      return unless @tty

      @thread&.kill
      draw(force: true)
      print "\e[?25h"
      $stdout.flush
    end

    # Temporarily wipe the panel (e.g. while PKGBUILD is shown)
    def pause
      return yield unless @tty

      @lock.synchronize do
        @paused = true
        print "\e[#{@drawn}F\e[J" if @drawn.positive?
        print "\e[?25h"
        @drawn = 0
      end
      begin
        yield
      ensure
        print "\e[?25l"
        @paused = false
      end
    end

    private

    def draw(force: false)
      @lock.synchronize do
        return if @paused && !force

        lines = frame_lines
        out = +''
        out << "\e[#{@drawn}F" if @drawn.positive?
        lines.each { |l| out << "\e[2K#{l}\n" }
        print out
        $stdout.flush
        @drawn = lines.size
        @tick += 1
      end
    end

    def frame_lines
      done = @items.count { |i| i.state == :done }
      head = "#{UI.ember('▸')} #{UI.bold(@title)} #{UI.dim("(#{done}/#{@items.size})")}"
      nw = @items.map { |i| i.name.size }.max.to_i
      vw = @items.map { |i| i.ver.to_s.size }.max.to_i
      room = [UI.width - nw - vw - 8, 12].max
      rows = @items.map do |i|
        icon = case i.state
               when :done   then UI.green('✔')
               when :active then UI.ember(FRAMES[@tick % FRAMES.size])
               when :failed then UI.red('✗')
               else UI.dim('○')
               end
        name = i.state == :pending ? UI.dim(i.name.ljust(nw)) : UI.bold(i.name.ljust(nw))
        text = UI.trunc(i.phase, room)
        phase = case i.state
                when :active then text
                when :failed then UI.red(text)
                else UI.dim(text)
                end
        "#{icon} #{name} #{UI.dim(i.ver.to_s.ljust(vw))}  #{phase}"
      end
      [head, *rows]
    end
  end

  # CLI 
  class CLI
    def initialize(argv)
      @opts = { yes: false, keep: false, review: false, verbose: false, help: false, version: false, query: false }
      @rest = []
      argv.each do |a|
        case a
        when '-y', '--yes', '--assume-yes', '--noconfirm' then @opts[:yes] = true
        when '--keep-deps'                                then @opts[:keep] = true
        when '--review'                                   then @opts[:review] = true
        when '--verbose'                                  then @opts[:verbose] = true
        when '-h', '--help'                               then @opts[:help] = true
        when '-v', '--version'                            then @opts[:version] = true
        when '-Q', 'list'                                 then @opts[:query] = true
        else @rest << a
        end
      end
    end

    def run
      return usage if @opts[:help]
      return puts("ember #{VERSION}") if @opts[:version]
      return query_packages(@rest) if @opts[:query]

      Ember.verbose = @opts[:verbose]
      raise Error, "Do not run ember as root — it calls #{Sh.su} when it needs to." if Process.uid.zero?

      cmd, *args = @rest
      case cmd
      when nil, 'update', 'upgrade', '-Syu'             then upgrade
      when 'install', 'ins', 'add', '-S'                then install(args)
      when 'local', '-U'                                then install_local(args)
      when 'remove', 'rm', 'uninstall', 'del', '-R'     then remove(args, purge: false)
      when 'purge'                                      then remove(args, purge: true)
      when 'search', 's', 'find'                        then search(args)
      when 'clean'                                      then clean
      when 'help'                                       then usage
      when 'version'                                    then puts("ember #{VERSION}")
      else
        UI.err("Unknown command '#{cmd}'")
        usage
        exit 1
      end
    rescue Error => e
      UI.err(e.message)
      exit 1
    rescue Interrupt
      puts
      exit 130
    ensure
      @keepalive&.kill
    end

    private

    def usage
      puts <<~TXT
        #{UI.ember('ember')} #{UI.dim(VERSION)} — an AUR helper with a pacman wrapper

        #{UI.bold('Usage:')} ember [options] <command> [packages…]   #{UI.dim('(emb works too)')}

        #{UI.bold('Commands:')}
          #{UI.ember('(none)')}, update      Update the system and all AUR packages
          #{UI.ember('install')}, ins        Install packages from the repos or the AUR
          #{UI.ember('local')}, -U           Install local package files (*.pkg.tar.*)
          #{UI.ember('remove')}, rm          Remove packages and unused dependencies
          #{UI.ember('purge')}               Like remove, but also drops config backups
          #{UI.ember('search')}, s           Search the repos and the AUR
          #{UI.ember('clean')}               Empty ember's cache (and pacman's)
          #{UI.ember('list')}                Creates a list of all installed packages

        #{UI.bold('Options:')}
          -y, --yes          Assume yes at every prompt
          --keep-deps        Keep AUR build dependencies after building
          --review           Read each PKGBUILD in your pager before anything is built
          --verbose          Show the full build and install output as it happens
          -h, --help         Show this help
          -v, --version      Show the version
      TXT
    end

    def query_packages(args)
      exec('pacman', '-Q', *args)
    end

    def confirm(question = 'Do you want to continue?')
      UI.confirm(question, assume: @opts[:yes])
    end

    def su(*cmd) = Sh.run(Sh.su, *cmd)

    def auth!
      return if @keepalive

      Sh.run(*Sh.su_auth) or raise Error, "#{Sh.su} authentication failed"
      quiet = { out: File::NULL, err: File::NULL }
      if Sh.su == 'doas' && !system(*Sh.su_auth(quiet: true), **quiet)
        raise Error, "doas needs 'persist' in /etc/doas.conf"
      end

      @keepalive = Thread.new do
        loop do
          sleep 50
          system(*Sh.su_auth(quiet: true), **quiet) unless Sh.su == 'syca'
        end
      end
    end

    # install 
    def install(names)
      raise Error, 'Nothing to install. Usage: ember install <package…>' if names.empty?

      planner = UI.spin('Resolving dependencies') { Planner.new(names).resolve }
      planner.already.each { |n| UI.note("#{UI.bold(n)} is already installed") }
      unless planner.missing.empty?
        raise Error, "Unable to locate #{planner.missing.size == 1 ? 'package' : 'packages'} " \
                     "#{planner.missing.join(', ')} in the repos or the AUR"
      end
      transact(planner: planner)
    end

    # install local package files 
    def install_local(args)
      raise Error, 'Nothing to install. Usage: ember -U <file.pkg.tar.zst…>' if args.empty?

      files = args.map { |a| File.expand_path(a) }.uniq
      files.each do |f|
        raise Error, "#{f.sub(Dir.home, '~')}: no such file" unless File.file?(f)
        raise Error, "#{File.basename(f)}: not a package file (*.pkg.tar.*)" unless f.match?(/\.pkg\.tar(\.\w+)?\z/)
      end

      info = nil
      deps = nil
      removals = nil
      UI.spin('Reading packages') do
        _, ok, err = Sh.capture('pacman', '-Qip', *files)
        unless ok
          msg = Sh.clean_errors(err)
          raise Error, msg.empty? ? 'Could not read the package files' : msg
        end

        info = Pac.info('-Qip', files)
        # everything pacman would pull in from the repos for these files
        out, ok, err = Sh.capture('pacman', '-U', '--print', '--print-format', '%n', '--noconfirm',
                                  *Pac::ASK_CONFLICTS, *files)
        raise Error, Sh.clean_errors(err) unless ok

        deps = out.lines.map(&:strip).reject(&:empty?) - info.keys
        incoming = info.transform_values do |h|
          { conflicts: Pac.split_deps(h['Conflicts With']), provides: Pac.split_deps(h['Provides']) }
        end
        removals = Pac.conflicts(incoming)
      end
      raise Error, 'Could not read the package files' if info.nil? || info.empty?

      @ask = removals.empty? ? [] : Pac::ASK_CONFLICTS
      old      = Pac.info('-Qi', info.keys)
      dep_info = Pac.info('-Si', deps)
      size_of  = ->(name) { UI.human(File.size(files[info.keys.index(name)])) }
      ver      = ->(name) { info[name]['Version'] }

      fresh = info.keys.reject { |n| old.key?(n) }
      same  = info.keys.select { |n| old.key?(n) && old[n]['Version'] == ver.call(n) }
      up    = info.keys - fresh - same
      sections = [
        { title: 'Installing:', color: UI::GREEN,
          rows: fresh.map { |n| UI::Row.new(n, ver.call(n), size_of.call(n)) } },
        { title: 'Upgrading:', color: UI::CYAN,
          rows: up.map { |n| UI::Row.new(n, "#{old[n]['Version']} → #{ver.call(n)}", size_of.call(n)) } },
        { title: 'Reinstalling:', color: UI::CYAN,
          rows: same.map { |n| UI::Row.new(n, ver.call(n), size_of.call(n)) } },
        { title: 'Dependencies (from the repos):', color: UI::AMBER,
          rows: deps.map do |n|
            UI::Row.new(n, dep_info.dig(n, 'Version'), UI.human(Pac.bytes(dep_info.dig(n, 'Download Size'))))
          end },
        { title: 'Removing (conflicting):', color: UI::RED,
          rows: removals.map { |n, r| UI::Row.new(n, r[:ver], UI.human(r[:size])) } }
      ].reject { |sec| sec[:rows].empty? }

      n_inst = fresh.size + deps.size
      lines = []
      lines << ['Install', n_inst, deps.empty? ? nil : "#{deps.size} from the repos"] if n_inst.positive?
      lines << ['Upgrade', up.size, nil] if up.any?
      lines << ['Reinstall', same.size, nil] if same.any?
      unless removals.empty?
        lines << ['Remove', removals.size, "conflicts with #{removals.values.map { |r| r[:by] }.uniq.join(', ')}"]
      end

      dl = deps.sum { |n| Pac.bytes(dep_info.dig(n, 'Download Size')) }
      disk = info.keys.sum { |n| Pac.bytes(info[n]['Installed Size']) - Pac.bytes(old.dig(n, 'Installed Size')) } +
             deps.sum { |n| Pac.bytes(dep_info.dig(n, 'Installed Size')) } -
             removals.values.sum { |r| r[:size] }
      stats = []
      stats << ['Total download size:', UI.human(dl)] if dl.positive?
      stats << ['Disk space required:', UI.human(disk)] if disk.positive?
      stats << ['Disk space freed:', UI.human(-disk)] if disk.negative?
      stats << ['Local packages:', 'installed from file']

      puts
      UI.table(sections)
      UI.summary(lines, stats)

      go = removals.empty? ? confirm : UI.confirm('Remove the conflicting packages and continue?')
      return UI.note('Aborted.') unless go

      auth!
      puts
      progress = Progress.new('Installing local packages')
      rows = info.keys.map { |n| progress.add(n, ver.call(n)) }
      progress.start
      begin
        rows.each { |r| progress.set(r, :active, 'installing') }
        ok, log = logged('local-install', Sh.su_n('pacman', '-U', '--noconfirm', *@ask, *files),
                         env: MAKEPKG_ENV) do |line|
          ph = pacman_phase(line)
          rows.each { |r| progress.set(r, :active, ph) } if ph
        end
        unless ok
          rows.each { |r| progress.set(r, :failed, 'failed') }
          fail_with(progress, nil, 'Could not install the packages', log)
        end
        rows.each { |r| progress.set(r, :done, 'installed') }
      ensure
        progress.stop
      end
      UI.ok('Done.')
    end

    # upgrade 
    def upgrade
      auth!
      UI.step 'Refreshing package databases'
      su('pacman', '-Sy') or raise Error, 'Could not refresh the package databases'

      repo_up, resolved = UI.spin('Calculating upgrades') { repo_upgrades }
      aur_old = {}
      planner = UI.spin('Checking the AUR') { aur_planner(aur_old) }

      res = transact(planner: planner, repo_up: repo_up, resolved_up: resolved, aur_old: aur_old)
      return unless res == :aborted

      UI.warn('Databases were refreshed but nothing was upgraded — run `ember` again before installing anything.')
    end

    def repo_upgrades
      ups = {}
      Sh.out('pacman', '-Qu').each_line do |l|
        next if l.include?('[ignored]')

        n, o, _, nw = l.split
        ups[n] = [o, nw] if nw
      end
      return [ups, []] if ups.empty?

      names = Sh.out('pacman', '-Sup', '--noconfirm', '--print-format', '%n').lines.map(&:strip).reject(&:empty?)
      [ups, (ups.keys + names).uniq]
    end

    def aur_planner(aur_old)
      foreign = Sh.out('pacman', '-Qm').lines.map(&:split).select { |a| a.size == 2 }.to_h
      infos = Aur.info(foreign.keys)
      ups = infos.select { |i| Sh.out('vercmp', foreign[i['Name']], i['Version']).strip.to_i.negative? }
      ups.each { |i| aur_old[i['Name']] = foreign[i['Name']] }
      Planner.new(ups.map { |i| i['Name'] }, aur_only: true).resolve
    rescue Error => e
      UI.warn("Skipping AUR: #{e.message}")
      Planner.new([], aur_only: true).resolve
    end

    def transact(planner:, repo_up: {}, resolved_up: [], aur_old: {})
      nodes = planner.ordered
      check_tools! unless nodes.empty?

      rt = planner.repo_targets + planner.repo_runtime
      rt_names  = rt.empty? ? [] : Pac.plan(rt)
      all_names = (rt.empty? && planner.repo_build.empty?) ? [] : Pac.plan(rt + planner.repo_build)
      build_names = all_names - rt_names
      fresh = ((resolved_up - repo_up.keys) + rt_names).uniq

      det = Pac.info('-Si', (resolved_up + all_names).uniq)
      old = Pac.info('-Qi', repo_up.keys)
      dl  = ->(n) { Pac.bytes(det.dig(n, 'Download Size')) }
      sz  = ->(n) { Pac.bytes(det.dig(n, 'Installed Size')) }
      row = ->(n) { UI::Row.new(n, det.dig(n, 'Version'), UI.human(dl.call(n))) }

      incoming = (fresh + repo_up.keys + build_names).uniq.to_h do |n|
        [n, { conflicts: Pac.split_deps(det.dig(n, 'Conflicts With')),
              provides: Pac.split_deps(det.dig(n, 'Provides')) }]
      end
      nodes.each { |n| incoming[n.name] = { conflicts: n.conflicts, provides: n.provides } }
      removals = UI.spin('Checking for conflicts') { Pac.conflicts(incoming) }
      @ask = removals.empty? ? [] : Pac::ASK_CONFLICTS

      aur_rt    = nodes.select(&:runtime)
      aur_new   = aur_rt.reject { |n| aur_old.key?(n.name) }
      aur_up    = aur_rt.select { |n| aur_old.key?(n.name) }
      aur_build = nodes.reject(&:runtime)

      build_title = @opts[:keep] ? 'Build dependencies (kept):' : 'Build dependencies (removed afterwards):'
      sections = [
        { title: 'Installing:', color: UI::GREEN, rows: fresh.map(&row) },
        { title: 'Installing from AUR:', color: UI::GREEN,
          rows: aur_new.map { |n| UI::Row.new(n.name, n.version, '—') } },
        { title: 'Upgrading:', color: UI::CYAN,
          rows: repo_up.map { |n, (o, nw)| UI::Row.new(n, "#{o} → #{nw}", UI.human(dl.call(n))) } },
        { title: 'Upgrading from AUR:', color: UI::CYAN,
          rows: aur_up.map { |n| UI::Row.new(n.name, "#{aur_old[n.name]} → #{n.version}", '—') } },
        { title: build_title, color: UI::AMBER,
          rows: build_names.map(&row) + aur_build.map { |n| UI::Row.new(n.name, n.version, '—') } },
        { title: 'Removing (conflicting):', color: UI::RED,
          rows: removals.map { |n, r| UI::Row.new(n, r[:ver], UI.human(r[:size])) } }
      ].reject { |s| s[:rows].empty? }

      if sections.empty?
        UI.ok('Nothing to do — everything is up to date.')
        return :empty
      end

      n_inst = fresh.size + aur_new.size
      n_up   = repo_up.size + aur_up.size
      n_aur  = aur_new.size + aur_up.size
      total_dl = (fresh + repo_up.keys + build_names).uniq.sum(&dl)
      disk = fresh.sum(&sz) + repo_up.keys.sum { |n| sz.call(n) - Pac.bytes(old.dig(n, 'Installed Size')) }
      temp = build_names.sum(&sz)
      disk -= removals.values.sum { |r| r[:size] }

      lines = []
      lines << ['Install', n_inst, n_aur.positive? && aur_new.any? ? "#{aur_new.size} from the AUR" : nil] if n_inst.positive?
      lines << ['Upgrade', n_up, aur_up.any? ? "#{aur_up.size} from the AUR" : nil] if n_up.positive?
      lines << ['Remove', removals.size, "conflicts with #{removals.values.map { |r| r[:by] }.uniq.join(', ')}"] unless removals.empty?
      stats = []
      stats << ['Total download size:', UI.human(total_dl)] if total_dl.positive?
      stats << ['Disk space required:', UI.human(disk)] if disk.positive?
      stats << ['Disk space freed:', UI.human(-disk)] if disk.negative?
      stats << ['Temporary build space:', UI.human(temp)] if temp.positive?
      stats << ['AUR packages:', 'built locally from source'] if n_aur.positive? || aur_build.any?

      puts
      UI.table(sections)
      UI.summary(lines, stats)

      go = removals.empty? ? confirm : UI.confirm('Remove the conflicting packages and continue?')
      unless go
        UI.note('Aborted.')
        return :aborted
      end

      auth!
      review_all(nodes) if @opts[:review] && !nodes.empty?
      execute(planner: planner, nodes: nodes, repo_up: repo_up)
      UI.ok('Done.')
      :done
    end

    def check_tools!
      %w[git makepkg].each do |b|
        raise Error, "'#{b}' not found — install it (pacman -S base-devel git)" unless Sh.which(b)
      end
    end

    MAKEPKG_ENV = { 'LC_MESSAGES' => 'C', 'LANGUAGE' => 'C' }.freeze
    PHASES = [
      [/\A(Making package|Checking (runtime|buildtime) dependencies)/, 'checking dependencies'],
      [/\A(Retrieving sources|Downloading)/, 'downloading sources'],
      [/\A(Validating|Verifying)/, 'verifying sources'],
      [/\AExtracting sources/, 'extracting sources'],
      [/\AStarting pkgver\(\)/, 'updating version'],
      [/\AStarting prepare\(\)/, 'preparing'],
      [/\AStarting build\(\)/, 'compiling'],
      [/\AStarting check\(\)/, 'running tests'],
      [/\AStarting package/, 'packaging'],
      [/\A(Creating|Compressing|Generating)/, 'creating package archive'],
      [/\ACleaning up/, 'cleaning up']
    ].freeze

    def execute(planner:, nodes:, repo_up:)
      unless repo_up.empty?
        UI.step 'Upgrading system packages'
        su('pacman', '-Su', '--noconfirm', *@ask) or raise Error, 'System upgrade failed'
      end

      # With AUR builds in the mix, repo packages nobody needs for building
      # are held back so everything can be confirmed together at the very end
      needed = nodes.flat_map { |n| n.repo_deps + n.repo_make }.to_set
      deferred_repo = nodes.empty? ? [] : planner.repo_targets.reject { |t| needed.include?(t) }
      early_targets = planner.repo_targets - deferred_repo

      unless early_targets.empty? && planner.repo_runtime.empty?
        UI.step 'Installing repository packages'
        unless early_targets.empty?
          su('pacman', '-S', '--needed', '--noconfirm', *@ask, *early_targets) or raise Error, 'pacman failed'
        end
        unless planner.repo_runtime.empty?
          su('pacman', '-S', '--needed', '--noconfirm', *@ask, '--asdeps', *planner.repo_runtime) or
            raise Error, 'pacman failed'
        end
      end

      return if nodes.empty?

      # AUR packages that other AUR packages need must be installed right away
      # the rest are built first and installed after one last confirmation
      dep_names = nodes.flat_map { |n| n.aur_deps + n.aur_make }.to_set
      finals = nodes.reject { |n| dep_names.include?(n.name) }.map(&:name).to_set

      added = Set.new
      build_only = Set.new
      ready = []
      declined = false
      need_deps = nodes.any? { |n| !cached(n) } && !planner.repo_build.empty?
      cleanup = !@opts[:keep] && (need_deps || nodes.any? { |n| !n.runtime })

      puts
      progress = Progress.new('Building AUR packages')
      deps_row  = need_deps ? progress.add('build dependencies', '') : nil
      repo_row  = deferred_repo.empty? ? nil : progress.add('repository packages', '')
      rows      = nodes.to_h { |n| [n.name, progress.add(n.name, n.version)] }
      clean_row = cleanup ? progress.add('cleanup', '') : nil
      progress.start

      begin
        if deps_row
          progress.set(deps_row, :active, 'installing')
          before = Pac.installed
          ok, log = pacman_logged('build-deps', ['-S', '--needed', '--noconfirm', *@ask, '--asdeps', *planner.repo_build],
                                  deps_row, progress)
          fail_with(progress, deps_row, 'Could not install build dependencies', log) unless ok
          added = Pac.installed - before
          progress.set(deps_row, :done, "#{added.size} #{added.size == 1 ? 'package' : 'packages'} installed")
        end

        nodes.each do |n|
          row = rows[n.name]
          files = cached(n)
          built = files.nil?
          if built
            files = build(n, row, progress)
          else
            progress.set(row, :active, 'using cached package')
          end
          build_only << n.name unless n.runtime

          if finals.include?(n.name)
            ready << [n, files, built]
            progress.set(row, :done, built ? 'built, ready to install' : 'cached, ready to install')
          else
            install_node(n, files, built, row, progress)
          end
        end

        # the one final confirmation
        unless ready.empty? && deferred_repo.empty?
          go = @opts[:yes] || progress.pause { final_confirm(deferred_repo, ready) }
          if go
            if repo_row
              progress.set(repo_row, :active, 'installing')
              ok, log = pacman_logged('repo-install', ['-S', '--needed', '--noconfirm', *@ask, *deferred_repo],
                                      repo_row, progress)
              fail_with(progress, repo_row, 'Could not install repository packages', log) unless ok
              progress.set(repo_row, :done, 'installed')
            end
            ready.each { |n, files, built| install_node(n, files, built, rows[n.name], progress) }
          else
            declined = true
            ready.each { |n, _, _| progress.set(rows[n.name], :failed, 'not installed') }
            progress.set(repo_row, :failed, 'not installed') if repo_row
          end
        end

        if clean_row
          progress.set(clean_row, :active, 'removing build dependencies')

          removed = (remove_build_deps(added | build_only) rescue nil)
          if removed
            progress.set(clean_row, :done, removed.empty? ? 'nothing to remove' : "removed #{removed.size} #{removed.size == 1 ? 'package' : 'packages'}")
          else
            progress.set(clean_row, :done, 'could not remove everything (see ~/.cache/ember/logs/cleanup.log)')
          end
        end

        if declined
          raise Error, "Installation declined — built packages stay in #{PKG_DIR.sub(Dir.home, '~')}, " \
                       "so the next run won't rebuild them"
        end
      ensure
        progress.stop
      end
    end

    def install_node(node, files, built, row, progress)
      flags = node.explicit ? [] : ['--asdeps']
      progress.set(row, :active, 'installing')
      ok, log = pacman_logged("#{node.name}-install", ['-U', '--noconfirm', *@ask, *flags, *files], row, progress)
      fail_with(progress, row, "Could not install #{node.name}", log) unless ok
      progress.set(row, :done, built ? 'built & installed' : 'installed from cache')
    end

    # Everything that is about to be installed
    # WHY DOESNT IT WORK??? (it does now qwq)
    def final_confirm(repo_targets, ready)
      names = repo_targets.empty? ? [] : Pac.plan(repo_targets)
      det = Pac.info('-Si', names)
      repo_rows = names.map do |n|
        UI::Row.new(n, det.dig(n, 'Version'), UI.human(Pac.bytes(det.dig(n, 'Download Size'))))
      end
      aur_rows = ready.map { |n, files, _| UI::Row.new(n.name, n.version, UI.human(files.sum { |f| File.size(f) })) }

      sections = [
        { title: 'Installing:', color: UI::GREEN, rows: repo_rows },
        { title: 'Installing from AUR:', color: UI::GREEN, rows: aur_rows }
      ].reject { |s| s[:rows].empty? }

      dl = names.sum { |n| Pac.bytes(det.dig(n, 'Download Size')) }
      stats = []
      stats << ['Total download size:', UI.human(dl)] if dl.positive?
      stats << ['AUR packages:', 'built, ready to install'] unless aur_rows.empty?

      puts
      UI.table(sections)
      UI.summary([['Install', repo_rows.size + aur_rows.size,
                   aur_rows.empty? ? nil : "#{aur_rows.size} from the AUR"]], stats)
      UI.confirm('Proceed with installation?')
    end

    def pacman_logged(name, args, row, progress)
      logged(name, Sh.su_n('pacman', *args), env: MAKEPKG_ENV) do |line|
        ph = pacman_phase(line)
        progress.set(row, :active, ph) if ph
      end
    end

    def pacman_phase(line)
      if (m = line.scan(%r{\((\d+)/(\d+)\) (installing|upgrading) (\S+)}).last)
        return "#{m[2]} #{m[3]} (#{m[0]}/#{m[1]})"
      end
      return 'downloading packages' if line.include?('Retrieving packages')
      return 'verifying packages' if line.match?(/checking (keys|package integrity|integrity)|loading package files/)
      return 'checking for conflicts' if line.include?('checking for file conflicts')
      return 'running hooks' if line.include?('post-transaction hooks')

      nil
    end

    # Run a command with all output going to a log file
    def logged(name, cmd, env: {}, chdir: nil)
      FileUtils.mkdir_p(LOG_DIR)
      log = File.join(LOG_DIR, "#{name}.log")
      opts = chdir ? { chdir: chdir } : {}
      ok = false
      File.open(log, 'w') do |f|
        Open3.popen2e(env, *cmd, **opts) do |stdin, out, wait|
          stdin.close
          out.each_line do |line|
            f.write(line)
            print line if Ember.verbose
            yield line if block_given?
          end
          ok = wait.value.success?
        end
      end
      [ok, log]
    rescue Errno::ENOENT
      raise Error, "#{cmd.first}: command not found"
    end

    def phase_of(line)
      m = line.match(/\A\s*(?:==>|->)\s*(.*)/) or return nil
      PHASES.find { |re, _| m[1].match?(re) }&.last
    end

    def fail_with(progress, row, msg, log)
      progress.set(row, :failed, 'failed') if row
      progress.stop
      tail = (File.readlines(log).last(25).join rescue '')
      $stderr.puts("\n#{UI.dim(tail)}") unless tail.empty? || Ember.verbose
      raise Error, "#{msg} — full log: #{log.sub(Dir.home, '~')}"
    end

    def cached(node)
      files = Dir.glob(File.join(PKG_DIR, "#{node.name}-*.pkg.tar*")).reject { |f| f.end_with?('.sig') }
      files = files.select { |f| File.basename(f).start_with?("#{node.name}-#{node.version}-") }
      files.empty? ? nil : files
    end

    def build(node, row, progress)
      FileUtils.mkdir_p([PKG_DIR, BUILD_DIR])
      dir = File.join(BUILD_DIR, node.base)

      progress.set(row, :active, 'fetching PKGBUILD')
      fetch_sources(node, dir) unless @fetched&.include?(node.base)

      progress.set(row, :active, 'starting build')
      env = MAKEPKG_ENV.merge('PKGDEST' => PKG_DIR)
      ok, log = logged(node.name, %w[makepkg -fc], env: env, chdir: dir) do |line|
        ph = phase_of(line)
        progress.set(row, :active, ph) if ph
      end
      fail_with(progress, row, "Failed to build #{node.name}", log) unless ok

      list, = Open3.capture2(env.merge('LC_ALL' => 'C'), 'makepkg', '--packagelist', chdir: dir)
      files = list.lines.map(&:strip).select do |f|
        File.file?(f) && File.basename(f).match?(/\A#{Regexp.escape(node.name)}-\d/)
      end
      fail_with(progress, row, "makepkg produced no package for #{node.name}", log) if files.empty?

      files
    end

    def fetch_sources(node, dir)
      quiet = { out: File::NULL, err: File::NULL }
      if Dir.exist?(File.join(dir, '.git')) && system('git', '-C', dir, 'pull', '--ff-only', '--quiet', **quiet)
        return
      end

      FileUtils.rm_rf(dir)
      system('git', 'clone', '--quiet', "https://aur.archlinux.org/#{node.base}.git", dir, **quiet) or
        raise Error, "Could not clone #{node.base} from the AUR"
    end

    # --review: read every PKGBUILD (and .install script) (IT TOOK SO LONG TO MAKE THIS WORK TF?)
    # upgraded, installed or built. Works for cached packages too (i hope lol)
    def review_all(nodes)
      pager = ENV['PAGER'] || 'less'
      @fetched ||= Set.new
      list = nodes.uniq(&:base)
      list.each_with_index do |n, i|
        dir = File.join(BUILD_DIR, n.base)
        UI.spin("Fetching PKGBUILD for #{n.name}") { fetch_sources(n, dir) }
        @fetched << n.base

        files = [File.join(dir, 'PKGBUILD'), *Dir.glob(File.join(dir, '*.install'))]
        UI.step "Reviewing #{n.name} #{UI.dim("(#{i + 1}/#{list.size})")}"
        system("#{pager} #{files.map { |f| Shellwords.escape(f) }.join(' ')}")
        raise Error, "Aborted at #{n.name} — nothing was installed" unless UI.confirm("Build #{n.name}?")
      end
    end

    def remove_build_deps(names)
      cand = names.select { |n| Pac.installed?(n) }
      return [] if cand.empty?

      required = Pac.info('-Qi', cand).transform_values do |h|
        h['Required By'].to_s.split.reject { |x| x == 'None' }
      end
      removable = cand.dup
      loop do
        drop = removable.select { |n| (required[n] || []).any? { |r| !removable.include?(r) } }
        break if drop.empty?

        removable -= drop
      end
      return [] if removable.empty?

      ok, = logged('cleanup', Sh.su_n('pacman', '-Rns', '--noconfirm', *removable))
      ok ? removable : nil
    end

    # remove / purge 
    def remove(names, purge:)
      raise Error, "Nothing to remove. Usage: ember #{purge ? 'purge' : 'remove'} <package…>" if names.empty?

      flags = purge ? '-Rnsp' : '-Rsp'
      out, ok, err = Sh.capture('pacman', flags, '--print-format', '%n', *names)
      raise Error, Sh.clean_errors(err) unless ok

      all = out.lines.map(&:strip).reject(&:empty?)
      raise Error, 'Nothing to remove.' if all.empty?

      targets = all.select { |n| names.include?(n) }
      targets = all if targets.empty?
      extras  = all - targets

      det = Pac.info('-Qi', all)
      mk = ->(n) { UI::Row.new(n, det.dig(n, 'Version'), UI.human(Pac.bytes(det.dig(n, 'Installed Size')))) }
      size = ->(list) { list.sum { |n| Pac.bytes(det.dig(n, 'Installed Size')) } }

      puts
      UI.table([{ title: 'Removing:', color: UI::RED, rows: targets.map(&mk) }])
      stats = [['Disk space freed:', UI.human(size.call(targets))]]
      unless extras.empty?
        stats << ['Unused dependencies:',
                  "#{extras.size} (#{UI.human(size.call(extras))}) — asked afterwards"]
      end
      UI.summary([['Remove', targets.size, nil]], stats)

      return UI.note('Aborted.') unless confirm

      auth!
      UI.step 'Removing packages'
      su('pacman', purge ? '-Rn' : '-R', '--noconfirm', *targets) or raise Error, 'pacman failed'

      unless extras.empty?
        puts
        UI.table([{ title: 'Unused dependencies:', color: UI::AMBER, rows: extras.map(&mk) }])
        puts UI.rule
        word = extras.size == 1 ? 'dependency' : 'dependencies'
        if confirm("Also remove #{extras.size} unused #{word} (#{UI.human(size.call(extras))})?")
          UI.step 'Removing unused dependencies'
          su('pacman', purge ? '-Rns' : '-Rs', '--noconfirm', *extras) or
            UI.warn('Could not remove some dependencies')
        else
          UI.note("Kept #{extras.size} unused #{word}.")
        end
      end
      UI.ok('Done.')
    end

    # search 
    def search(terms)
      raise Error, 'Nothing to search for. Usage: ember search <term…>' if terms.empty?

      re = Regexp.union(terms.map do |t|
        (Regexp.new(t, Regexp::IGNORECASE) rescue Regexp.new(Regexp.escape(t), Regexp::IGNORECASE))
      end)
      aur_err = nil
      repo, aur = UI.spin('Searching repos and the AUR') do
        r = repo_search(terms)
        a = begin
          aur_search(terms, re)
        rescue Error => e
          aur_err = e.message
          []
        end
        [r, a]
      end

      UI.warn("AUR search skipped: #{aur_err}") if aur_err
      if repo.empty? && aur.empty?
        UI.note("No packages found matching #{UI.bold(terms.join(' '))}")
        return
      end
      show_results('Repositories', repo, re)
      show_results('AUR', aur, re)
      puts
    end

    def repo_search(terms)
      items = []
      cur = nil
      Sh.out('pacman', '-Ss', *terms).each_line do |l|
        l = l.chomp
        if l.start_with?(' ')
          cur[:desc] = l.strip if cur
        elsif (m = l.match(%r{\A(\S+?)/(\S+) (\S+)(.*)\z}))
          cur = { name: m[2], ver: m[3], tag: m[1], installed: m[4].include?('installed'), desc: '' }
          items << cur
        end
      end
      items
    end

    def aur_search(terms, re)
      query = terms.max_by(&:size).gsub(/[^\w@.+-]/, '')
      have = Pac.installed
      Aur.search(query)
         .select { |i| terms.size == 1 || "#{i['Name']} #{i['Description']}".match?(re) }
         .sort_by { |i| -i['NumVotes'].to_i }
         .first(30)
         .map do |i|
        { name: i['Name'], ver: i['Version'], tag: 'aur', votes: i['NumVotes'],
          stale: i['OutOfDate'], installed: have.include?(i['Name']), desc: i['Description'] }
      end
    end

    def show_results(title, items, re)
      return if items.empty?

      puts "\n#{UI.ember(title)} #{UI.dim("(#{items.size})")}"
      items.each do |i|
        meta = [UI.dim(i[:tag])]
        meta << UI.dim("▲#{i[:votes]}") if i[:votes]
        meta << UI.amber('out of date') if i[:stale]
        meta << UI.green('✔ installed') if i[:installed]
        puts "#{UI.hl(i[:name], re, base: "\e[1m")} #{UI.green(i[:ver])}  #{meta.join('  ')}"
        puts "  #{UI.hl(UI.trunc(i[:desc], UI.width - 4), re)}" unless i[:desc].to_s.empty?
      end
    end

    # clean 
    def dir_size(dir)
      Dir.glob(File.join(dir, '**', '*'), File::FNM_DOTMATCH).sum do |f|
        File.file?(f) && !File.symlink?(f) ? File.size(f) : 0
      rescue SystemCallError
        0
      end
    end

    def clean
      items = [
        ['Built AUR packages', PKG_DIR],
        ['AUR sources & clones', BUILD_DIR],
        ['Build logs', LOG_DIR],
        ['Pacman package cache', PACMAN_CACHE]
      ].map { |label, dir| [label, dir, dir_size(dir)] }

      puts
      puts UI.rule
      puts " #{UI.ember('Cache:'.ljust(24))} #{UI.ember('Location:'.ljust(34))} #{UI.ember('Size:'.rjust(9))}"
      puts UI.rule
      items.each do |label, dir, size|
        puts " #{UI.bold(label.ljust(24))} #{UI.dim(dir.sub(Dir.home, '~').ljust(34))} #{UI.human(size).rjust(9)}"
      end
      puts UI.rule
      puts " #{'Total to free:'.ljust(24)} #{' ' * 34} #{UI.bold(UI.human(items.sum { |i| i[2] })).rjust(9)}"
      puts

      return UI.note('Aborted.') unless confirm('Clean all caches?')

      auth!
      [PKG_DIR, BUILD_DIR, LOG_DIR].each do |dir|
        next unless Dir.exist?(dir)

        system('chmod', '-R', 'u+w', dir, err: File::NULL)
        Dir.children(dir).each { |c| FileUtils.rm_rf(File.join(dir, c)) }
      end
      UI.step 'Cleaning the pacman cache'
      Sh.run('sh', '-c', "yes | #{Sh.su} pacman -Scc >/dev/null") or UI.warn('pacman could not clean its cache')
      UI.ok('Caches cleaned.')
    end
  end
end

Ember::CLI.new(ARGV).run
